# Seeds ERP — producción (EC2)
# Copiar:  cp .env.production.example .env.production
# NO commitear .env.production

# --- Django ---
DJANGO_SECRET_KEY=REEMPLAZAR_con_openssl_rand_hex_32
DJANGO_DEBUG=false
DJANGO_SETTINGS_MODULE=app.settings.production
# Elastic IP + dominio HTTPS del ERP
DJANGO_ALLOWED_HOSTS=erp.seedscol.com,52.5.54.227,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://erp.seedscol.com,http://52.5.54.227
CORS_ALLOWED_ORIGINS=https://erp.seedscol.com,http://52.5.54.227

# true con HTTPS en erp.seedscol.com
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0

# --- Cifrado panel Configuración ---
# Generar: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SEEDS_SECRETS_KEY=REEMPLAZAR_token_urlsafe_32

# --- Postgres ---
POSTGRES_DB=seeds_erp
POSTGRES_USER=seeds
POSTGRES_PASSWORD=REEMPLAZAR_password_fuerte

# --- Admin bootstrap ---
DJANGO_SUPERUSER_EMAIL=admin@seeds.co
DJANGO_SUPERUSER_PASSWORD=REEMPLAZAR_password_admin
DJANGO_SUPERUSER_NAME=Admin Seeds
SEEDS_BOOTSTRAP_SEEDS=1

GUNICORN_WORKERS=3
CELERY_CONCURRENCY=2

# Same-origin vía nginx
VITE_API_URL=
